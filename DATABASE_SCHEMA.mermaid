    %% Relationships
    TENANT ||--o{ USER : "has"
    TENANT ||--o{ CONTRACT : "owns"
    TENANT ||--o{ COUNTERPARTY : "manages"
    TENANT ||--o{ CHAT_SESSION : "has"
