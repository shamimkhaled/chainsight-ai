    %% Core Models
    TENANT {
        uuid id PK
        string name
        string subdomain UK
        string company_name
        string logo
        string status
        boolean is_active
        string plan_type
        boolean is_trial
        datetime trial_ends_at
        datetime subscription_start
        datetime subscription_end
        string contact_email
        string contact_phone
        string address
        string city
        string country
