        integer user_count
        integer contract_count
        bigint storage_used
        integer max_users
        integer max_contracts
        bigint max_storage
        datetime created_at
        datetime updated_at
    }
    
    USER {
        uuid id PK
        uuid tenant_id FK
        string email UK
        string password
        string first_name
        string last_name
        string phone_number
