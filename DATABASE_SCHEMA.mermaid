    CHAT_SESSION ||--o{ CHAT_MESSAGE : "contains"
    
    CLAUSE ||--o{ CONTRACT_COMMENT : "commented_on"
    
    CONTRACT_COMMENT ||--o{ CONTRACT_COMMENT : "replies_to"
    
