{
  "info": {
    "name": "ChainSight AI - Complete API Collection",
    "description": "Complete API collection for ChainSight AI Contract Intelligence Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Register Tenant & Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('access_token', jsonData.access_token);",
                  "    pm.environment.set('refresh_token', jsonData.refresh_token);",
                  "    pm.environment.set('tenant_id', jsonData.tenant.id);",
                  "    pm.environment.set('user_id', jsonData.admin_user.id);",
                  "    console.log('✅ Tokens and IDs saved to environment');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company_name\": \"Acme Corporation\",\n  \"subdomain\": \"acmecorp\",\n  \"admin_email\": \"admin@acmecorp.com\",\n  \"admin_password\": \"SecurePassword123!\",\n  \"admin_first_name\": \"John\",\n  \"admin_last_name\": \"Doe\",\n  \"admin_phone\": \"+1-555-0123\",\n  \"plan_type\": \"professional\",\n  \"billing_email\": \"billing@acmecorp.com\",\n  \"industry\": \"manufacturing\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/tenants/register/",
              "host": ["{{base_url}}"],
              "path": ["tenants", "register", ""]
            },
            "description": "Register a new tenant (company) with admin user"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('access_token', jsonData.access);",
                  "    pm.environment.set('refresh_token', jsonData.refresh);",
                  "    pm.environment.set('tenant_id', jsonData.user.tenant.id);",
                  "    console.log('✅ Login successful - Tokens saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@acmecorp.com\",\n  \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/token/",
              "host": ["{{base_url}}"],
              "path": ["auth", "token", ""]
            },
            "description": "Login with email and password to get JWT tokens"
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('access_token', jsonData.access);",
                  "    console.log('✅ Access token refreshed');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/token/refresh/",
              "host": ["{{base_url}}"],
              "path": ["auth", "token", "refresh", ""]
            },
            "description": "Refresh access token using refresh token"
          }
        }
      ]
    },
